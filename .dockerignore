# Keep owner data, credentials, VCS and local dependencies out of build contexts.
**/.git
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.key
**/id_*
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/*.pyc
**/*.log
**/out
**/dist
**/build
**/.forge
**/.idea
**/.vscode
