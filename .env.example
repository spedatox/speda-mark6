# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional providers. Fill only the connections you intend to use.
OPENAI_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
# MOONSHOT_API_KEY is accepted as an alternative to KIMI_API_KEY.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
# Set a model here or through the authenticated model-policy API.
LLM_MAIN_MODEL=
LLM_BACKGROUND_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=90
CHAT_MAX_OUTPUT_TOKENS=16384
KIMI_BASE_URL=https://api.moonshot.ai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Optional service account file; otherwise Vertex uses Application Default Credentials.
VERTEX_CREDENTIALS_FILE=

# ── Database ───────────────────────────────────────────────────────────────────
# Owner overrides persist in SPEDA_DATA_DIR/configuration.json and take precedence
# over deployment env/.env after saving. Keep this directory on a private volume.
# SPEDA_DATA_DIR=/data
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Empty follows the conversation; en/tr pins user-facing prose after restart.
AGENT_LANGUAGE=
DATABASE_URL=sqlite+aiosqlite:///./speda.db
MEMORY_CAPTURE_ENABLED=true
# Iacon paid maintenance stays at zero until /iacon/maintenance has finite
# call/token/microdollar limits and a conservative rate for the effective model.
IACON_TELEGRAM_TOKEN=
IACON_TELEGRAM_CHAT_ID=0
IACON_TELEGRAM_OWNER_ID=0
HISAR_BASE_URL=http://localhost:8002
HISAR_LIBRARY_SYNC_TOKEN=
HISAR_LIBRARY_READER_TOKEN=
HISAR_MACHINE_TOKEN=
# Leave other integrations off while evaluating the renovated memory path.
EXTERNAL_INTEGRATIONS_ENABLED=false

# Rooms use pinned persona/provider policies and start with spending paused.
ORCHESTRATION_PROFILES_ENABLED=true
ORCHESTRATION_ROOMS_ENABLED=true
PROJECT_EXECUTION_ENABLED=false
PROJECT_SUPERVISION_ENABLED=true
# Configure disjoint directories on the verified execution host.
PROJECT_WORKSPACE_ROOT=
# FORGE_WORKSPACE_ROOT remains accepted as a deployment compatibility alias.
PROJECT_STATE_ROOT=
PROJECT_HOST_ID=local
PROJECT_CELL_BACKEND=docker
PROJECT_CELL_IMAGE=
# Trusted operator-managed deployment recipes; empty disables publication.
PROJECT_RELEASE_TARGETS_FILE=
HOUSE_PARTY_PASSPHRASE=

# ── Auth ───────────────────────────────────────────────────────────────────────
# API key for all SPEDA endpoints (X-API-Key header)
SPEDA_API_KEY=change-me-before-production

# Shared secret for n8n webhook trigger (X-N8N-Secret header)
N8N_SECRET=change-me-n8n-secret

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
# Reports observed incidents to the privately linked SPEDA Telegram bot.
DAMAGE_CONTROL_ENABLED=false

# ── Temp outputs ───────────────────────────────────────────────────────────────
TEMP_OUTPUTS_DIR=/tmp/speda_outputs

# ── MCP servers (fill in as each is configured) ────────────────────────────────
# NOTION_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT=https://your-api-host/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_OAUTH_REDIRECT=https://your-api-host/oauth/microsoft/callback
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT=https://your-api-host/oauth/notion/callback
# Every npx/uvx built-in requires an operator-reviewed exact version in this map.
# No unpinned package is downloaded/executed. See docs/MCP.md before enabling.
MCP_PACKAGE_PINS={}
# BRAVE_SEARCH_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# GITHUB_TOKEN=

# ── OSS Adapters ───────────────────────────────────────────────────────────────
# GPT_RESEARCHER_URL=http://localhost:8000
# SHANNON_URL=http://localhost:9000

# Native automation and delivery activation (see docs/AUTOMATIONS.md and TRANSPORTS.md)
N8N_API_URL=
N8N_API_KEY=
SPEDA_CALLBACK_URL=http://speda:8000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKENS={}
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=0
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
ELEVENLABS_API_KEY=
TTS_DEFAULT_VOICE=azure:tr-TR-EmelNeural
TTS_LOCALE=tr-TR
VOICE_CANVAS_ENABLED=true
VOICE_CANVAS_MAX_PANELS=24
# Paid speech additionally requires explicit external_prices in the global budget.
SOLUS_UI_DIR=
ONYX_API_URL=
ONYX_API_TOKEN=
SANDBOX_URL=
