# ─────────────────────────────────────────────────────────────────────────────
# Orion Spark — Reliability Watchdog Configuration
# Copy to spark.env or /opt/speda/spark.env and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# Target Speda probe settings
SPARK_SPEDA_HOST=127.0.0.1
SPARK_SPEDA_PORT=8000
SPARK_LIVE_PATH=/health/live
SPARK_READY_PATH=/health/ready
SPARK_FALLBACK_PATH=/health
SPARK_PROBE_INTERVAL_SECONDS=15
SPARK_PROBE_TIMEOUT_SECONDS=5

# Outage detection & Defibrillation
SPARK_FAILURE_THRESHOLD=3
SPARK_STABILITY_WINDOW_SECONDS=300
SPARK_STARTUP_GRACE_PERIOD_SECONDS=30

# Docker & Git target
SPARK_DOCKER_COMPOSE_FILE=docker-compose.yml
SPARK_DOCKER_SERVICE=app
SPARK_REPO_DIR=/opt/speda

# Anti-looping recovery bounds
SPARK_RECOVERY_COOLDOWN_SECONDS=60
SPARK_MAX_RESTART_ATTEMPTS=1
SPARK_MAX_ROLLBACK_ATTEMPTS=1

# Storage directory for state.json and incidents.jsonl
SPARK_STATE_DIR=/opt/speda/spark

# Independent Notification (direct Bot API or Webhook — no Speda dependency)
SPARK_TELEGRAM_BOT_TOKEN=
SPARK_TELEGRAM_CHAT_ID=
SPARK_WEBHOOK_URL=

# Optional Custom Commands (leave empty to use default docker compose & git)
# SPARK_RESTART_COMMAND="docker compose restart app"
# SPARK_DEPLOY_COMMAND="docker compose up -d --build app"
# SPARK_ROLLBACK_COMMAND="git checkout {lkg} && docker compose up -d --build app"

# Operational
SPARK_DRY_RUN=false
SPARK_LOG_LEVEL=INFO
