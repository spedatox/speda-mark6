<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Reading the wrist's own sensors. BODY_SENSORS_BACKGROUND is the one
         that matters for this app's whole premise: without it, passive
         monitoring stops the moment the app leaves the foreground, which is
         every moment that counts. It is a runtime grant on API 33+ and must be
         requested AFTER BODY_SENSORS has been granted — the system rejects a
         combined request. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- WorkManager expedited work on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AtomixWear"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- Standalone: this watch app talks to Igor directly over the network
             and needs no phone-side companion. That is the entire point —
             see docs/ATOMIX_WEAR.md §1.1. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Services delivers batched passive data here, waking the
             process as needed. Not exported: only the platform binds it. -->
        <service
            android:name=".health.BiometricListenerService"
            android:exported="false"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <!-- FCM wake. Data-only messages only; a message carrying a
             `notification` block is rendered by the system tray while the app is
             backgrounded and onMessageReceived never runs, which would make the
             sync demand undeliverable exactly when it matters. -->
        <service
            android:name=".sync.SyncMessagingService"
            android:exported="false"
            tools:ignore="MissingFirebaseInstanceTokenRefresh">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".health.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
