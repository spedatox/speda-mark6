{
  "name": "Onyx — ticket webhook to Ultron",
  "meta": {
    "description": "Receives real-time ticket events (created, updated, comment, completed, reopened) from Onyx and triggers Ultron Mark III to manage the owner's tasks and deliver a sharp, natural Telegram push notification."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "onyx-ticket-events",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "onyx-webhook-trigger",
      "name": "Onyx Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "onyx-ticket-events",
      "notes": "Receives inbound webhook notifications from the Onyx ticketing platform. In Onyx Settings ▸ Webhooks, point the endpoint URL to this webhook (e.g. https://<n8n-domain>/webhook/onyx-ticket-events). Ensure the workflow is toggled to Active!"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://app:8000/trigger/ultron",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SPEDA_API_KEY }}"
            },
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ \"payload\": { \"type\": \"onyx_event\", \"automation\": \"Onyx hook\", \"event\": $json.body.event || $json.event, \"ticket\": $json.body.ticket || $json.ticket, \"comment\": $json.body.comment || $json.comment, \"data\": $json.body || $json }, \"output_mode\": \"push\" }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "notify-ultron",
      "name": "Notify Ultron",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Relays the Onyx payload to Ultron via /trigger/ultron. Ultron will automatically sync the task to Google Tasks (on creation and completion) and speak a lively, human push message into Telegram without raw field dumps."
    }
  ],
  "connections": {
    "Onyx Webhook": {
      "main": [
        [
          {
            "node": "Notify Ultron",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
