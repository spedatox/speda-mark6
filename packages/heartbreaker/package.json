{
  "name": "speda-mark6",
  "version": "3.0.0",
  "description": "Speda Mark VI — primary desktop client",
  "main": "./out/main/index.js",
  "author": "Ahmet Erol Bayrak",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "teaser:dev": "vite --config vite.teaser.config.ts",
    "teaser:build": "vite build --config vite.teaser.config.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "electron-vite": "3.1.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0",
    "vite": "6.4.5"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/three": "^0.185.3",
    "katex": "0.19.1",
    "maplibre-gl": "6.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  }
}
