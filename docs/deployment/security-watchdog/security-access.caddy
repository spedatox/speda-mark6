log security_watchdog {
	output file /data/security-watchdog/access.log {
		mode 0640
		roll_size 16MiB
		roll_keep 2
		roll_uncompressed
		backup_time_format 2006-01-02T15-04-05.000
	}
	format filter {
		fields {
			request>uri delete
			request>headers delete
			request>host delete
			request>tls delete
			request>method delete
			request>proto delete
			request>remote_port delete
			request>client_ip delete
			request>client_port delete
			resp_headers delete
			user_id delete
			bytes_read delete
			duration delete
			size delete
		}
		wrap json
	}
}
