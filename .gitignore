# Environment
.env
.env.*
!.env.example

# Claude Code — personal/local settings (the shared launch.json is committed)
.claude/settings.local.json

# Local databases (may contain secrets — never commit)
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
dist/
build/
*.egg-info/
.eggs/

# …but electron-builder uses `build/` as its buildResources SOURCE directory,
# not as output. The blanket rule above was silently swallowing the app icon,
# so it was never committed — electron-builder.yml pointed at a file that did
# not exist in any clone, and both the installer and every `dev` run fell back
# to Electron's default logo. Re-include just that tree.
!packages/heartbreaker/build/
!packages/heartbreaker/build/**

# Virtual environment
.venv/
venv/
env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Temp outputs
/tmp/speda_outputs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Node / Electron
node_modules/
packages/*/out/
packages/*/.vite/
packages/*/*.tsbuildinfo

# Proprietary fonts — kept local, not redistributed in this public repo
Samsung*.ttf
references/

# Generated Caddy site blocks for optional peers (contain real hostnames).
caddy-sites/*
!caddy-sites/.gitkeep
packages/igor/scripts/tts_samples/
# Forge scratch: session state, allowlist, and worktrees an agent created here
.forge/
.forge-worktrees/

# Forge scratch — run_command output spills, never source
.forge_spill/
